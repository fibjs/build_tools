#!/bin/bash

usage() {
    echo ""
    echo "Usage: $(basename $0) [options] [-jn] [-v] [-h]"
    echo "Options:"
    echo "  release, debug: "
    echo "      Specifies the build type."
    echo "  ia32, x64, arm, arm64, mips64, ppc64, s390x, riscv64, loong64, loong64ow:"
    echo "      Specifies the architecture for code generation."
    echo "  android, alpine, linux, iphone, iphone-simulator:"
    echo "      Specifies the target platform."
    echo "  clean: "
    echo "      Clean the build folder."
    echo "  -h, --help:"
    echo "      Print this message and exit."
    echo "  -j: enable make '-j' option."
    echo "      if 'n' is not given, will set jobs to auto detected core count, otherwise n is used."
    echo "  --use-msvc:"
    echo "      force use msvc on Windows, default is clangcl."
    echo ""
}

for i in "$@"; do
    case $i in
    ia32 | x64 | arm | arm64 | mips64 | ppc64 | s390x | riscv64 | loong64 | loong64ow)
        BUILD_ARCH=$i
        ;;
    alpine | android | linux | iphone | iphone-simulator | darwin | win32)
        BUILD_OS=$i
        ;;
    release | debug)
        BUILD_TYPE=$i
        ;;
    clean)
        CLEAN_BUILD="true"
        ;;
    -j*)
        BUILD_JOBS="${i#-j}"
        ;;
    --help | -h)
        usage
        exit 1
        ;;
    --use-msvc)
        BUILD_WITH_MSVC=true
        shift
        ;;
    *)
        echo "illegal option $i"
        usage
        exit 1
        ;;
    esac
done

# ---------------------------------------------------------------------------
# Configure and build the CMake project of the current directory in one pass:
#
#   out/<OS>_<ARCH>_<TYPE>/   build tree (one subdirectory per target)
#   bin/<OS>_<ARCH>_<TYPE>/   artifacts
#
# The distribution directory name is computed by
# build_tools/cmake/config.cmake, so shell and CMake always agree.
# ---------------------------------------------------------------------------

VENDER_ROOT="${VENDER_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
WORK_ROOT="${WORK_ROOT:-$(dirname "${VENDER_ROOT}")}"
BUILD_TOOLS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

export VENDER_ROOT WORK_ROOT

# The distribution directory name is computed by build_tools/cmake/config.cmake,
# so shell and CMake always agree.
DIST_DIRNAME=$(cmake -DBUILD_ARCH=${BUILD_ARCH} \
    -DBUILD_TYPE=${BUILD_TYPE} \
    -DBUILD_OS=${BUILD_OS} \
    -P "${BUILD_TOOLS_ROOT}/cmake-scripts/dist_dirname.cmake" 2>&1 | tail -n 1 | sed 's/^-- //' | sed 's/\x1b\[[0-9;]*m//g' | tr -d '\r')

case "${DIST_DIRNAME}" in
*_*_*) ;;
*)
    echo "failed to detect the distribution directory name: '${DIST_DIRNAME}'"
    exit 1
    ;;
esac

BIN_DIR="${WORK_ROOT}/bin/${DIST_DIRNAME}"

# Two kinds of repositories are supported:
#
#   * a single CMake project at the repository root (vender, fibjs): configured
#     and built in one pass below
#   * a repository that drives its own build from a script-mode build.cmake
#     (addon repositories such as fib-jieba, via fib-addon/build.cmake): that
#     script receives the same -D arguments as before
if [[ -f build.cmake ]]; then
    cmake -DBUILD_ARCH=${BUILD_ARCH} \
        -DBUILD_TYPE=${BUILD_TYPE} \
        -DBUILD_OS=${BUILD_OS} \
        -DCLEAN_BUILD=${CLEAN_BUILD} \
        -DBUILD_JOBS=${BUILD_JOBS} \
        -DBUILD_WITH_MSVC=${BUILD_WITH_MSVC} \
        -DFIBJS_BIN_DIR=${BIN_DIR} \
        -P build.cmake
    exit $?
fi

BUILD_DIR="${WORK_ROOT}/out/${DIST_DIRNAME}"

if [[ "${BUILD_JOBS}" == "" ]]; then
    BUILD_JOBS=$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || echo 1)
fi
# BUILD_CMAKE_EXTRA_ARGS is a plain string (the caller exports it).  build_env.sh
# sets IFS to newline, so split it explicitly instead of relying on the shell.
extra_args=()
if [[ "${BUILD_CMAKE_EXTRA_ARGS}" != "" ]]; then
    IFS=' ' read -r -a extra_args <<< "${BUILD_CMAKE_EXTRA_ARGS}"
fi

BUILD_DIR="${WORK_ROOT}/out/${DIST_DIRNAME}"

if [[ "${CLEAN_BUILD}" == "true" ]]; then
    rm -rf "${WORK_ROOT}/out" "${WORK_ROOT}/bin"
fi

mkdir -p "${BUILD_DIR}"

if [[ "$(uname)" == MINGW* || "$(uname)" == MSYS* || "$(uname)" == CYGWIN* ]]; then
    case ${BUILD_ARCH} in
    x64) TargetArch=x64 ;;
    ia32) TargetArch=Win32 ;;
    arm64) TargetArch=ARM64 ;;
    arm) TargetArch=ARM ;;
    esac

    if [[ "${BUILD_WITH_MSVC}" == "" ]]; then
        MSBUILD_BUILD_TARGET="-T ClangCL"
    fi

    cmake -Wno-author \
        -DBUILD_OS=${BUILD_OS} \
        -DBUILD_ARCH=${BUILD_ARCH} \
        -DBUILD_TYPE=${BUILD_TYPE} \
        -DBUILD_JOBS=${BUILD_JOBS} \
        -DFIBJS_BIN_DIR=${BIN_DIR} \
        ${MSBUILD_BUILD_TARGET} \
        -A ${TargetArch} \
        "${extra_args[@]}" \
        -S . -B "${BUILD_DIR}"
    if [ $? != 0 ]; then
        exit 1
    fi

    # The trailing switches are passed to MSBuild.  Git Bash would rewrite
    # /nologo and /p:... into paths, so its argument conversion is disabled for
    # this call - which means the build directory has to be given in native
    # form (cygpath is available in Git Bash, and absent elsewhere).
    BUILD_DIR_NATIVE="${BUILD_DIR}"
    if command -v cygpath >/dev/null 2>&1; then
        BUILD_DIR_NATIVE="$(cygpath -m "${BUILD_DIR}")"
    fi

    MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' cmake --build "${BUILD_DIR_NATIVE}" -j ${BUILD_JOBS} \
        --config ${BUILD_TYPE} \
        -- /nologo /verbosity:minimal /p:CL_MPcount=${BUILD_JOBS}
    if [ $? != 0 ]; then
        exit 1
    fi
else
    cmake -Wno-author \
        -DBUILD_OS=${BUILD_OS} \
        -DBUILD_ARCH=${BUILD_ARCH} \
        -DBUILD_TYPE=${BUILD_TYPE} \
        -DBUILD_JOBS=${BUILD_JOBS} \
        -DFIBJS_BIN_DIR=${BIN_DIR} \
        "${extra_args[@]}" \
        -S . -B "${BUILD_DIR}"
    if [ $? != 0 ]; then
        exit 1
    fi

    cmake --build "${BUILD_DIR}" -- -j${BUILD_JOBS}
fi

if [ $? != 0 ]; then
    exit 1
fi
