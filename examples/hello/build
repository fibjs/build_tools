#!/bin/bash
#
# Entry script of the example: the same shape as the entry scripts of the real
# repositories (vender/build, fibjs/build).  build_env.sh checks the
# dependencies and dispatches a cross build into the build image, scripts/build
# configures and builds the CMake project of this directory in one pass:
#
#   bash build x64 release -j4
#
# The outputs land in <example>/{out,bin}.

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

cd "$(dirname "$0")" || exit 1

# build_tools is the repository root here (not a "vender" submodule), so the
# checkout, the output root and the directory the build image re-enters are
# stated explicitly.
export VENDER_ROOT="${ROOT}"
export WORK_ROOT="$(pwd)"
export BUILD_ENTRY="$(pwd)"

. "${ROOT}/scripts/build_env.sh"
. "${ROOT}/scripts/build"
