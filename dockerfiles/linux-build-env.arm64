FROM fibjs/linux-build-env:x64

RUN apt-get install g++-aarch64-linux-gnu -y && \
    dpkg --add-architecture arm64 && \
    sed -i 's|^deb http://archive.ubuntu.com|deb [arch=amd64] http://archive.ubuntu.com|g' /etc/apt/sources.list && \
    sed -i 's|^deb http://security.ubuntu.com|deb [arch=amd64] http://security.ubuntu.com|g' /etc/apt/sources.list && \
    echo "deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports focal main universe" >> /etc/apt/sources.list && \
    echo "deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports focal-updates main universe" >> /etc/apt/sources.list && \
    apt-get update && apt-get install libedit-dev:arm64 -y
ENV QEMU_LD_PREFIX="/usr/aarch64-linux-gnu"
